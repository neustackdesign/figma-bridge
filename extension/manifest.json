{
  "manifest_version": 3,
  "name": "Figma Bridge — Capture",
  "version": "0.3.1",
  "description": "Capture complete website screenshots and animated scrolling workflows as PNG, JPG, MP4 or GIF.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "debugger",
    "downloads",
    "tabCapture",
    "offscreen",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Capture with Figma Bridge",
    "default_popup": "popup.html"
  }
}
